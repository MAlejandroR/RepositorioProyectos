{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "algolia/algoliasearch-client-php": "^4.43.1",
        "filament/filament": "^v5.6.2",
        "google/apiclient": "^v2.19.3",
        "inertiajs/inertia-laravel": "v3.1.0",
        "laravel/fortify": "v1.37.0",
        "laravel/framework": "v13.8.0",
        "laravel/jetstream": "v5.5.2",
        "laravel/sanctum": "^v4.3.2",
        "laravel/scout": "^v11.1.0",
        "laravel/socialite": "^v5.27.0",
        "laravel/tinker": "^v3.0.2",
        "league/csv": "^9.28.0",
        "spatie/laravel-permission": "^7.4.1",
        "tightenco/ziggy": "^v2.6.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v4.2.8",
        "fakerphp/faker": "^v1.24.1",
        "filament/upgrade": "^v5.6.2",
        "laravel-lang/common": "^6.8.0",
        "laravel-shift/blueprint": "^v2.13.0",
        "laravel/pint": "^v1.29.1",
        "laravel/sail": "^v1.58.0",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^v8.9.4",
        "pestphp/pest": "^v4.7.0",
        "pestphp/pest-plugin-laravel": "^v4.1.0",
        "phpunit/phpunit": "^12.5.24",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": ["app/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
